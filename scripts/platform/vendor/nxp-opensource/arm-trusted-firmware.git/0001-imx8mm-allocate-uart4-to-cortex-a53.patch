 	RDC_PDAPn(RDC_PDAP_UART1, D0R | D0W),
 
@@ -117,7 +117,7 @@ static const struct imx_rdc_cfg rdc[] = {
 	RDC_MDAn(RDC_MDA_M4, DID1),
 
